•	Zna podstawowe zaimplementowane w Javie lambdy, tj. Function, Predicate, Consumer, Supplier
Function<String, Integer> lengthLambda = (String in) -> in.length(); // accepts String returns Integer
Predicate<String> emptyLambda = (String in) -> in.isEmpty();  // accepts String returns Boolean

Consumer<Error> errorConsumer = (Error e) -> System.out.println(e.getMessage());  // accepts String returns void

Supplier<String> supplier = () -> "lalala"; // accepts nothing returns String

void test() {
    Integer a = lengthLambda.apply("lalala"); // a = 6
    Boolean b = emptyLambda.test(""); // b = true;

    try {
        throw new Error("Sample error");
    } catch (Error e) {
        errorConsumer.accept(e);
    }
    
    System.out.println(supplier.get()); // lalala
}

3.	Strumienie na kolekcjach
•	Potrafi za wykorzystaniem strumieni:
o	Filtrować elementy kolekcji (metoda filter)
o	Mapować obiekty na obiekty innego typu (metoda map)
o	Sprawdzać czy elementy w kolekcji spełniają zadany warynek (metody anyMatch, allMatch)
o	Korzystać z metod takich jak: distinct, skip, limit, sorter
o	Korzystać z kolektorów (np. zamiany kolekcji na mape, grupować obiekty, wykonywać proste obliczenia)
public class Question3 {
    List<Integer> numbers = List.of(1, 3, 4, 5, 6, 7, 8, 9, 53, 8, 76, 65756, 98, 0, 98);

    void test() {
        var a = numbers.stream()
                .filter(n -> n < 50)
                .map(n -> n * n)
                .allMatch(n -> n > 0); // a = true

        var b = List.of(1, 1, 2, 3, 4, 4, 4, 5).stream().distinct().toList(); // [1, 2, 3, 4, 5]
        var c = Stream.of(1, 1, 2, 3, 4, 4, 4, 5).skip(2).limit(4).toList(); // [2, 3, 4, 4]
        var d = Stream.of(1, 1, 2, 3, 4, 4, 4, 5).sorted(); // sort

        var e = numbers.stream()
                .filter(n -> n < 50)
                .collect(Collectors.toMap(n -> n, n -> n * n)); // { 1, 1 }, {3, 9}, { 4, 16 } ..... // one to one relation

        var f = Stream.of(new Book(), new Book(), new Book()).collect(Collectors.groupingBy(Book::getType));// one to many relation
        var g = numbers.stream().mapToLong(n -> n).average().orElse(Double.NaN);
        var h = numbers.stream().mapToLong(n -> n).max().orElse(Long.MAX_VALUE);
    }
}

